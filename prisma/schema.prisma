// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  AGENT
  ADMIN
}

enum PropertyType {
  FOR_SALE
  FOR_RENT
}

enum PropertyCategory {
  APARTMENT
  HOUSE
  DUPLEX
  COMMERCIAL
  WAREHOUSE
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionPlan {
  FREE_TRIAL
  BASIC
  PREMIUM
}

enum SubscriptionDuration {
  MONTHLY
  QUARTERLY
  HALF_YEAR
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE 
  EXPIRED
  CANCELLED
  PAST_DUE
  GRACE_PERIOD
}

enum FeaturedStatus {
  ACTIVE 
  EXPIRED
  CANCELLED
}

enum PaymentType {
  SUBSCRIPTION
  FEATURED_LISTING
}

enum PaymentStatus {
  PENDING
  FAILED
  REFUNDED
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  firstName String
  lastName  String
  role   Role  @default(BUYER)
  emailVerifed  Boolean  @default(false)
  emailOtp String?
  emailOtpExpiresAt DateTime?
  isActive Boolean @default(true)
  resetToken String?
  resetTokenExpiresAt  DateTime?
  lastLogin     DateTime?
  

  // agent specific
  defaultViewingDuration   Int?
  stripeCustomerId   String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt


  //Relation
  refreshTokens RefreshToken[]
  properites   Property[]
  bookingsAsBuyer  Booking[]  @relation("BuyerBookings")
  bookingsAsAgent  Booking[]  @relation("AgentBookings")
  subscription    Subscription?
  packageRecords  PackageRecord[]
  reviews        Review[]
  savedProperties  SavedProperty[]
  featuredListings  FeaturedListing[]
  payments   Payment[]

  // index
  @@index([resetToken,resetTokenExpiresAt])
  @@index([email,emailOtp,emailVerifed,emailOtpExpiresAt])
  @@index([email,isActive])
}


model RefreshToken {
  id   String  @id  @default(uuid())
  token  String   @unique
  userId   String
  user     User @relation(fields: [userId],references: [id],onDelete: Cascade)
  expiresAt  DateTime
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model Property {
  id    String    @id  @default(uuid())
  agentId   String
  agent  User    @relation(fields: [agentId],references: [id])
  title  String
  description  String
  type   PropertyType
  category   PropertyCategory
  status   PropertyStatus  @default(DRAFT)
  price    Float
  address   String
  city     String
  state    String
  country  String
  latitude  Float?
  longitude Float?
  bedrooms   Int?
  bathrooms  Int?
  squareFootage  Float?
  featured    Boolean   @default(false)
  viewingDuration  Int?

  createdAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt


  //relations
  images   PropertyImage[]
  bookings  Booking[]
  reviews   Review[]
  savedBy   SavedProperty[]
  featuredHistory  FeaturedListing[]

  //index
  @@index([agentId])
  @@index([status])
  @@index([type])
  @@index([city,status])
  @@index([featured,status])
  @@index([category])

}

model PropertyImage {
  id   String  @id @default(uuid())
  propertyId  String
  property  Property  @relation(fields: [propertyId],references: [id],onDelete:Cascade)
  url  String
  publicId   String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model Booking {
  id   String   @id @default(uuid())
  propertyId   String
  property  Property  @relation(fields: [propertyId],references: [id])
  buyerId   String
  buyer User    @relation("BuyerBookings",fields: [buyerId],references: [id])
  agentId  String
  agent    User   @relation("AgentBookings",fields: [agentId],references: [id])
  status   BookingStatus   @default(PENDING)
  startTime   DateTime
  endTime     DateTime
  notes    String?
  cancelledBy   String?
  cancelReason  String?
  reminderJobId  String?
  autoConfirmJobId String?

  createdAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  //Relation
  review Review?


  @@index([buyerId])
  @@index([agentId])
  @@index([propertyId])
  @@index([buyerId,status])
  @@index([agentId,status])
  @@index([startTime])
}

model Subscription {
  id   String    @id  @default(uuid())
  userId   String   @unique
  user     User    @relation(fields: [userId],references: [id])
  plan     SubscriptionPlan
  duration   SubscriptionDuration
  status   SubscriptionStatus  @default(ACTIVE)
  stripeCustomerid    String?
  stripeSubscriptionId  String? @unique
  price   Float
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelledAt   DateTime?
  gracePeriodEnd   DateTime?
  reminderJobId    String? 

  dunningAttempts   Int   @default(0)
  dunningLastAttempts  DateTime?
  dunningFinalFailedAt  DateTime?

  maxProperties  Int?
  maxFeatureListings  Int?
  maxBookings   Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt


  //relations
  packageRecords  PackageRecord[]
  payments  Payment[]

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([status,currentPeriodEnd])
}

model PackageRecord {
  id   String @id  @default(uuid())
  userId   String
  user     User   @relation(fields: [userId],references: [id])
  subscriptionId   String
  subscription    Subscription @relation(fields: [subscriptionId],references: [id])
  stripeSubscriptionid String
  subscriptionCycleId  String @unique
  plan   SubscriptionPlan
  isTrial  Boolean @default(false)
  startDate  DateTime
  endDate    DateTime

  // usage tracking for this billing cycle
  propertiesUsed  Int  @default(0)
  featuredListingsUsed  Int  @default(0)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([subscriptionCycleId])

}

model FeaturedListing {
  id   String  @id  @default(uuid())
  propertyId   String
  property   Property  @relation(fields: [propertyId],references: [id])
  agentId   String
  agent   User  @relation(fields: [agentId],references: [id])
  status  FeaturedStatus  @default(ACTIVE)
  amountPaid  Float
  stripePaymentId  String?
  startDate  DateTime  @default(now())
  expiresAt   DateTime
  expiryJobId  String? 
  

  createdAt DateTime @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([propertyId])
  @@index([agentId])
  @@index([status,expiresAt])
}

model Payment {
  id   String  @id @default(uuid())
  userId   String
  user    User   @relation(fields: [userId],references: [id])
  subscriptionId  String?
  subscription  Subscription?  @relation(fields: [subscriptionId],references: [id])
  type  PaymentType
  status  PaymentStatus
  amount  Float
  currency  String   @default("usd")
  stripePaymentId  String?  @unique
  description  String?

  @@index([userId])
  @@index([stripePaymentId])
  @@index([subscriptionId])
}

model SavedProperty {
  id  String  @id @default(uuid())
  userId   String
  user   User  @relation(fields: [userId],references: [id])
  propertyId  String
  property  Property @relation(fields: [propertyId],references: [id])
  createdAt DateTime @default(now())

  @@unique([userId,propertyId])
  @@index([userId])
}

model Review {
  id  String  @id @default(uuid())
  propertyId  String
  proporty Property @relation(fields: [propertyId],references: [id])
  userId  String
  user   User  @relation(fields: [userId],references: [id])
  bookingId String @unique
  booking Booking  @relation(fields: [bookingId],references: [id])
  rating Int 
  comment String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId,userId])
  @@index([userId])
  @@index([propertyId,userId])
}

model WebhookEvent {
  id  String  @id  @default(uuid())
  eventId   String  @unique
  eventType   String
  payload   Json
  status   String  @default("PENDING")
  error   String?
  processedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([status])
}